@inherits LayoutComponentBase

<div>
    <!--Header-->
    <header>
        <nav class="navbar navbar-expand-lg navbar-gradient navbar-dark">
            <div class="container-fluid">
                <a class="navbar-brand" href="/">EventEase</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <NavLink href="/" Match="NavLinkMatch.All" class="nav-link" activeClass="active">Home
                            </NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink href="/events" class="nav-link" activeClass="active">Events</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink href="/register" class="nav-link" activeClass="active">Register</NavLink>
                        </li>
                        <li class="nav-item">
                            <NavLink href="/manage-events" class="nav-link" activeClass="active">Manage Events</NavLink>
                        </li>
                        @*<li class="nav-item">
                            <NavLink href="/eventregistration" class="nav-link" activeClass="active">Add Event</NavLink>
                        </li>
                        *@
                    </ul>
                </div>
            </div>
        </nav>
    </header>



    <!--Main Content-->
    <main class="container mt-4">
        @Body
    </main>

    <!--Footer-->
    <footer class="footer-custom text-center">
        &copy; @DateTime.Now.Year EventEase. All rights reserved.
    </footer>
</div>