@page "/eventregistration"
@using EventEaseApp.Models
@using EventEaseApp.Services

<div class="form-card">
    <h3 class="form-title">Register a New Event</h3>

    <EditForm Model="newEvent" OnValidSubmit="HandleValidSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary class="error-summary" />

        <div class="form-group">
            <label class="form-label">Name:</label>
            <InputText @bind-Value="newEvent.Name" class="form-input" />
        </div>

        <div class="form-group">
            <label class="form-label">Date:</label>
            <div class="date-picker-wrapper">
                <InputDate @bind-Value="newEvent.Date" class="form-input date-picker-input" />
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Location:</label>
            <InputText @bind-Value="newEvent.Location" class="form-input" />
        </div>

        <button type="submit" class="submit-btn">Submit</button>
    </EditForm>

    @if (submitted)
    {
        <p class="success-msg">Event <strong>@newEvent.Name</strong> registered successfully!</p>
    }
</div>


@code
{
    private EventModel newEvent = new()
    {
        Date = DateTime.Today
    };

    private bool submitted = false;

    private void HandleValidSubmit()
    {
        submitted = true;

        Console.WriteLine($"Event registered: {newEvent.Name}, {newEvent.Date}, {newEvent.Location}");
    }
}
