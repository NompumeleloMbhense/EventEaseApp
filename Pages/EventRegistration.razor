@page "/eventregistration"
@using EventEaseApp.Models
@using EventEaseApp.Services


<h3 class="event-form-title">Register a New Event</h3>

<EditForm Model="newEvent" OnValidSubmit="HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="event-form-label">
        <label>Name:</label>
        <InputText @bind-Value="newEvent.Name" class="event-form-input" />
    </div>

    <div class="event-form-label">
        <label>Date:</label>
        <InputDate @bind-Value="newEvent.Date" class="event-form-input" />
    </div>

    <div class="event-form-label">
        <label>Location:</label>
        <InputText @bind-Value="newEvent.Location" class="event-form-input" />
    </div>

    <button type="submit" class="btn btn-warning text-white fw-bold">Submit</button>
</EditForm>

@if (submitted)
{
    <p class="text-success mt-3">Event <strong>@newEvent.Name</strong> registered successfully!</p>
}



@code {
    private EventModel newEvent = new()
    {
        Date = DateTime.Today
    };

    private bool submitted = false;

    private void HandleValidSubmit()
    {
        submitted = true;

        Console.WriteLine($"Event registered: {newEvent.Name}, {newEvent.Date}, {newEvent.Location}");
    }
}

