<!--Pages/EventCard.razor-->
@using EventEaseApp.Models;

<div class="event-card">
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title">@Event.Name</h5>
            <p class="card-text"><strong>Date:</strong> @Event.Date.ToShortDateString()</p>
            <p class="card-text"><strong>Location:</strong> @Event.Location</p>

            @if(!string.IsNullOrWhiteSpace(Event.Description))
            {
                <p class="card-description">@Event.Description</p>
            }
            @if(!string.IsNullOrWhiteSpace(Event.Category))
            {
                <p class="card-category"><strong>Category: </strong>@Event.Category</p>
            }
            @if(Event.Tags?.Count > 0)
            {
                <div class="card-tags">
                    @foreach(var tag in Event.Tags)
                    {
                        <span class="tag">@tag</span>
                    }
                </div>
            }


            <a class="btn btn-outline-primary bottom-button" href="/eventdetails/@Event.Id">View Details</a>
        </div>
    </div>
</div>

@code
{
    [Parameter]
    required public EventModel Event { get; set; }

}
