@page "/"
@using EventEaseApp.Models
@using EventEaseApp.Pages
@inject EventEaseApp.Services.UserSessionState SessionState

<div class="landing-container">
    @if (!string.IsNullOrEmpty(SessionState.UserName))
    {
        <p class="welcome">Welcome back <strong>@SessionState.UserName</strong></p>
    }

    <h1 class="hero-title">Welcome to EventEase</h1>
    <p class="hero-subtitle">Discover and track events and stay organized</p>

    <a href="/events" class="btn-action">Browse Events</a>

    <section class="features">
        <h2>Why EventEase?</h2>
        <ul>
            <li><strong>Easy Browsing:</strong> View all upcoming events in one place</li>
            <li><strong>Simple Registration:</strong> Register for your favorite events in seconds</li>
            <li><strong>Stay Informed:</strong> See detailed info for each event you care about</li>
        </ul>
    </section>
</div>
