@page "/register"
@using EventEaseApp.Models
@using EventEaseApp.Services
@inject EventEaseApp.Services.UserSessionState SessionState
@inject AttendanceTrackerService AttendanceService

<div class="form-card">
    <h3 class="form-title">User Registration</h3>

    <EditForm Model="registration" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary class="error-summary" />

        <div class="form-group">
            <label class="form-label">Name:</label>
            <InputText @bind-Value="registration.Name" class="form-input" />
        </div>

        <div class="form-group">
            <label class="form-label">Email:</label>
            <InputText @bind-Value="registration.Email" class="form-input" />
        </div>

        <button type="submit" class="submit-btn">Register User</button>
    </EditForm>

    @if (submitted)
    {
        <p class="success-msg">Thank you, @registration.Name! Registration complete.</p>
    }
</div>

@code
{
    private UserRegistrationModel registration = new();
    private bool submitted = false;

    private void HandleSubmit()
    {
        submitted = true;

        // Save registration data to session state
        SessionState.UserName = registration.Name;
        SessionState.Email = registration.Email;

        // Register attendance for EventId
        AttendanceService.RegisterAttendance(
        eventId: 1,
        UserName: registration.Name,
        email: registration.Email
        );


        //Reset the form
        registration = new();
    }
}