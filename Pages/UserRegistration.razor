@page "/register"
@using EventEaseApp.Models
@using EventEaseApp.Services
@inject EventEaseApp.Services.UserSessionState SessionState


<div class="form-card">
    <h3 class="form-title">User Registration</h3>

    <EditForm Model="registration" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        

        <div class="form-group">
            <label class="form-label">Name:</label>
            <InputText @bind-Value="registration.Name" class="form-input" />
            <ValidationMessage For="@(() => registration.Name)" class="field-error"/>
        </div>

        <div class="form-group">
            <label class="form-label">Email:</label>
            <InputText @bind-Value="registration.Email" class="form-input" />
            <ValidationMessage For="@(() => registration.Email)" class="field-error"/>
        </div>

        <button type="submit" class="submit-btn">Register User</button>
    </EditForm>

    @if (submitted)
    {
        <p class="success-msg">Thank you, @SessionState.UserName! Registration complete.</p>
    }
</div>

@code
{
    private UserRegistrationModel registration = new();
    private bool submitted = false;

    private void HandleSubmit()
    {
        submitted = true;

        // Save info to session
        SessionState.UserName = registration.Name;
        SessionState.Email = registration.Email;

        Console.WriteLine($"User session set: {SessionState.UserName}, {SessionState.Email}");


        //Reset the form
        registration = new();
    }
}